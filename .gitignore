# Dependências: vêm do "npm install" (nunca enviar a pasta inteira)
node_modules/

# Segredos e configuração local: NUNCA enviar ao GitHub
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
signing-key-info.txt
# Android (PWABuilder): o APK/AAB e os arquivos da chave de assinatura ficam só no computador do proprietário.
# Atenção: o .gitignore vale para quem usa o git no computador; o envio pelo site do GitHub ("Upload files") NÃO o respeita
# (por isso o teste sem-segredos também reprova esses arquivos no GitHub Actions).
*.apk
*.aab
*.idsig
dados-da-chave*
chave-de-envio/

# Logs
*.log
npm-debug.log*

# Sistema e editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Saídas locais
coverage/

# Rastros de provedores de nuvem (Supabase, Cloudflare etc.): chaves e configuração local NUNCA no GitHub
supabase/.temp/
supabase/.env*
supabase/.branches/
.dev.vars
.wrangler/
credentials*.json
service-account*.json
*.p12
*.pfx
